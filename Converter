<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FileForge - Image to PDF Converter (Private & Local)</title>
    <meta name="description" content="Convert single or multiple images to a single PDF document securely in your browser.">
    
    <!-- Load pdf-lib from CDN -->
    <script src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
    
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --bg-color: #f8fafc;
            --surface: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --success: #10b981;
            --error: #ef4444;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 1000px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Header */
        .site-header {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 15px 0;
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-logo {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary);
            text-decoration: none;
        }

        /* Buttons */
        .btn {
            display: inline-block;
            padding: 10px 20px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-size: 1rem;
            transition: background 0.2s;
        }

        .btn-primary { background: var(--primary); color: white; }
        .btn-primary:hover { background: var(--primary-hover); }
        .btn-secondary { background: white; color: var(--primary); border: 1px solid var(--primary); }
        .btn-large { width: 100%; padding: 15px; font-size: 1.1rem; }
        .btn-text { background: none; color: var(--text-muted); text-decoration: underline; margin-top: 10px; }

        /* Tool Interface */
        .tool-page {
            padding: 40px 20px;
            text-align: center;
        }

        .privacy-badge {
            display: inline-block;
            background: #ecfdf5;
            color: #047857;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.9rem;
            margin-bottom: 25px;
            font-weight: 500;
        }

        .converter-interface {
            background: var(--surface);
            border: 2px dashed var(--border);
            border-radius: 12px;
            padding: 40px;
            max-width: 700px;
            margin: 0 auto 40px;
            transition: border-color 0.3s;
        }

        .converter-interface.dragover {
            border-color: var(--primary);
            background: #eff6ff;
        }

        .upload-prompt span {
            display: block;
            margin: 10px 0;
            color: var(--text-muted);
        }

        .format-note {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 15px;
        }

        .file-list {
            text-align: left;
            margin-top: 20px;
        }

        .file-item {
            padding: 10px;
            background: var(--bg-color);
            border-radius: 6px;
            margin-bottom: 10px;
            font-size: 0.9rem;
            display: flex;
            justify-content: space-between;
        }

        .action-area {
            margin-top: 25px;
        }

        .status-message {
            margin-top: 15px;
            font-weight: 500;
        }
        
        .status-error { color: var(--error); }
        .status-success { color: var(--success); }

        /* Footer */
        .site-footer {
            margin-top: auto;
            background: var(--surface);
            border-top: 1px solid var(--border);
            padding: 20px 0;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <header class="site-header">
        <div class="container header-container">
            <a href="#" class="brand-logo">FileForge</a>
            <span class="privacy-badge">🔒 Local Client-Side Processing</span>
        </div>
    </header>

    <main class="container tool-page">
        <h1>Convert Images to PDF</h1>
        <p style="color: #64748b; margin-bottom: 20px;">Instantly combine JPG, PNG, or WebP images into a single PDF document without uploading anything to a server.</p>

        <div class="converter-interface" id="drop-zone">
            <!-- Hidden input that handles the file selection dialog -->
            <input type="file" id="file-input" multiple accept="image/jpeg, image/png, image/webp" hidden>
            
            <div class="upload-prompt" id="upload-prompt">
                <p style="font-weight: 600; font-size: 1.2rem;">Drag & Drop Images Here</p>
                <span>or</span>
                <button class="btn btn-secondary" onclick="document.getElementById('file-input').click()">Select Files</button>
                <p class="format-note">Supported Formats: JPG, PNG, WebP</p>
            </div>
            
            <!-- List of selected files will appear here -->
            <div id="file-preview-list" class="file-list"></div>
            
            <!-- Action buttons hidden by default -->
            <div class="action-area" id="action-area" style="display: none;">
                <button id="convert-btn" class="btn btn-primary btn-large">Convert to PDF</button>
                <button id="reset-btn" class="btn btn-text">Clear All Files</button>
            </div>
            
            <div id="status-message" class="status-message"></div>
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>&copy; 2026 FileForge. Files never leave your device.</p>
        </div>
    </footer>

    <!-- JavaScript Logic -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const fileInput = document.getElementById('file-input');
            const dropZone = document.getElementById('drop-zone');
            const filePreviewList = document.getElementById('file-preview-list');
            const actionArea = document.getElementById('action-area');
            const convertBtn = document.getElementById('convert-btn');
            const resetBtn = document.getElementById('reset-btn');
            const statusMessage = document.getElementById('status-message');
            const uploadPrompt = document.getElementById('upload-prompt');

            let selectedFiles = [];

            // Drag and Drop Events
            dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.classList.add('dragover');
            });

            dropZone.addEventListener('dragleave', () => {
                dropZone.classList.remove('dragover');
            });

            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('dragover');
                handleFiles(e.dataTransfer.files);
            });

            // File selection via button
            fileInput.addEventListener('change', (e) => {
                handleFiles(e.target.files);
            });

            // Reset Button
            resetBtn.addEventListener('click', resetUI);

            // Trigger Conversion Process
            convertBtn.addEventListener('click', async () => {
                if (selectedFiles.length === 0) return;
                
                convertBtn.disabled = true;
                convertBtn.textContent = "Processing locally in browser...";
                statusMessage.className = "status-message";
                statusMessage.textContent = "";

                try {
                    // Check if PDF-Lib loaded correctly from CDN
                    if (window.PDFLib) {
                        await convertImagesToPdf(selectedFiles);
                    } else {
                        throw new Error("PDF engine not loaded. Please check your internet connection.");
                    }
                } catch (error) {
                    console.error(error);
                    statusMessage.textContent = "Error: " + error.message;
                    statusMessage.className = "status-message status-error";
                } finally {
                    convertBtn.disabled = false;
                    convertBtn.textContent = "Convert to PDF";
                }
            });

            // Validating file formats
            function handleFiles(files) {
                const validTypes = ['image/jpeg', 'image/png', 'image/webp'];
                
                for (let file of files) {
                    if (validTypes.includes(file.type)) {
                        selectedFiles.push(file);
                    } else {
                        alert(`${file.name} is not a supported image format.`);
                    }
                }
                updateUI();
            }

            // Displaying selected files in UI
            function updateUI() {
                if (selectedFiles.length > 0) {
                    uploadPrompt.style.display = 'none';
                    actionArea.style.display = 'block';
                    
                    filePreviewList.innerHTML = selectedFiles.map((file, index) => 
                        `<div class="file-item">
                            <span>${file.name}</span>
                            <span>${(file.size / 1024 / 1024).toFixed(2)} MB</span>
                        </div>`
                    ).join('');
                } else {
                    resetUI();
                }
            }

            // Resetting UI back to upload prompt
            function resetUI() {
                selectedFiles = [];
                fileInput.value = '';
                uploadPrompt.style.display = 'block';
                actionArea.style.display = 'none';
                filePreviewList.innerHTML = '';
                statusMessage.textContent = '';
            }

            // Core functionality: Embeds images into a new PDF using pdf-lib
            async function convertImagesToPdf(files) {
                const { PDFDocument } = window.PDFLib;
                const pdfDoc = await PDFDocument.create();

                for (const file of files) {
                    const arrayBuffer = await file.arrayBuffer();
                    let pdfImage;

                    // Support for WebP works similarly to JPG extraction in modern browsers
                    if (file.type === 'image/jpeg' || file.type === 'image/webp') {
                        pdfImage = await pdfDoc.embedJpg(arrayBuffer);
                    } else if (file.type === 'image/png') {
                        pdfImage = await pdfDoc.embedPng(arrayBuffer);
                    }

                    // Get dimensions of the image and scale it to fit precisely onto a 1:1 page
                    const { width, height } = pdfImage.scale(1);
                    const page = pdfDoc.addPage([width, height]);

                    // Draw the image filling the entire page
                    page.drawImage(pdfImage, {
                        x: 0,
                        y: 0,
                        width: width,
                        height: height,
                    });
                }

                // Generate PDF as bytes
                const pdfBytes = await pdfDoc.save();
                
                // Prompt user to download the generated file locally
                triggerDownload(pdfBytes, 'FileForge_Converted.pdf', 'application/pdf');
                
                statusMessage.textContent = "Success! PDF generated securely in your browser.";
                statusMessage.className = "status-message status-success";
            }

            // Browser download trigger helper
            function triggerDownload(byteData, fileName, mimeType) {
                const blob = new Blob([byteData], { type: mimeType });
                const url = URL.createObjectURL(blob);
                
                const a = document.createElement('a');
                a.href = url;
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
                
                setTimeout(() => {
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                }, 100);
            }
        });
    </script>
</body>
</html>
